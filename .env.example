# Nokopē uz .env.local (lokāli) un ievadi tos pašus mainīgos Vercel:
# Project -> Settings -> Environment Variables. Īstās vērtības nekad neliec Git.

# E-pasta sūtīšana (jau izmantots pasūtījumiem)
RESEND_API_KEY=

# ---- Admin panelis (/admin) ----
# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon" / "publishable" atslēga: tikai lasīšanai, drīkst būt publiska
SUPABASE_ANON_KEY=
# "service_role" / "secret" atslēga: pilna piekļuve, TIKAI serverī
SUPABASE_SERVICE_ROLE_KEY=
# Kuri e-pasti drīkst ielogoties (ar komatu, ja vairāki)
ADMIN_EMAILS=klients@example.com
# Nejauša virkne, vismaz 32 rakstzīmes. Terminālī: openssl rand -base64 48
ADMIN_SESSION_SECRET=
